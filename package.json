{
  "name": "obsidian-telegram-publisher",
  "version": "0.3.1",
  "description": "Публикация викторин из Obsidian в отложку Telegram",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=browser --format=cjs --target=es2022 --external:obsidian --outfile=dist/main.js"
  },
  "type": "module",
  "devDependencies": {
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  },
  "private": true
}
